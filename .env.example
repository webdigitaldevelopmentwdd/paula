# Enquiry form (Contact page). Set these in Coolify -> your app -> Environment Variables.
# Until all three are set, the form tells visitors their message was NOT sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@eclesare.com
# Must be an address on a domain verified in Resend, e.g. "Eclesare Website <enquiries@eclesarewedding.com>"
CONTACT_FROM_EMAIL=
